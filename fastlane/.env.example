# Certificate names shown by: security find-identity -v -p codesigning
MAC_APPLICATION_IDENTITY="Developer ID Application: NAME (TEAMID)"
MAC_INSTALLER_IDENTITY="Developer ID Installer: NAME (TEAMID)"

# Name passed to: xcrun notarytool store-credentials
APPLE_NOTARY_KEYCHAIN_PROFILE="samsung-fus-cli-notary"

# Reverse-DNS package receipt identifier.
MAC_PACKAGE_IDENTIFIER="dev.samsungfus.cli"
